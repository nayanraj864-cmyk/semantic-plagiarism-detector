# ==========================================
# Application Environment Variables Template
# Copy this file to .env and replace the
# placeholder values before running locally.
# ==========================================

# Redis
REDIS_URL=redis://localhost:6379/0

# External Webhook
PLAGIARISM_WEBHOOK_URL=https://example.com/webhook

# API Authentication
API_BEARER_TOKEN=your_api_bearer_token_here

 docs/add-env-example-1181
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
=======
# ── Redis Configuration ────────────────────────────────────────────────────────

# Redis connection URL (overrides individual host/port settings if provided)
REDIS_URL=

# Redis server host (fallback if REDIS_URL not set)
REDIS_HOST=localhost

# Redis server port (fallback if REDIS_URL not set)
REDIS_PORT=6379

# Redis database number (fallback if REDIS_URL not set)
REDIS_DB=0

# Redis password (if required)
REDIS_PASSWORD=

# Default Cache Key Expiration TTL in seconds (default: 3600 seconds / 1 hour)
REDIS_CACHE_TTL=3600

# ── Daily Summary Email Configuration ───────────────────────────────────────────

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=admin@example.com

# ── LMS REST API Configuration ───────────────────────────────────────────────

API_BEARER_TOKEN=your-secret-lms-bearer-token

# Timeout (in seconds) when attempting to acquire synchronization locks.
LOCK_TIMEOUT_SECONDS=30

# ── Database Backup Configuration ─────────────────────────────────────────────

# Backup idle timeout in minutes. The system will automatically back up the
# database after this duration of system-wide inactivity.
# Default: 30
BACKUP_IDLE_TIMEOUT_MINUTES=30

# ── Embedding Model Configuration ─────────────────────────────────────────────

# Batch size for forward passes during SentenceTransformer vector encoding.
# Tune lower (e.g. 16 or 32) for low-VRAM GPUs/CPUs, or higher (e.g. 64 or 128) for high-memory GPUs.
EMBEDDING_BATCH_SIZE=32

# ── Content Security Policy (CSP) Configuration (Issue #1561) ─────────────────

# Optional: endpoint to receive CSP violation reports from browsers.
# If set, a report-uri directive is appended to the CSP header.
# Example: https://your-domain.com/csp-report
CSP_REPORT_URI=

# Optional: comma-separated list of additional script-src hosts to allow-list.
# Use this to whitelist private CDNs or testing origins without editing source.
# Example: https://cdn.your-domain.com,https://assets.example.com
CSP_EXTRA_SCRIPT_HOSTS=

# Optional: comma-separated list of additional connect-src hosts (e.g. Supabase
# project URLs that differ across deployment environments).
# Example: https://abc123.supabase.co,https://api.your-domain.com
CSP_EXTRA_CONNECT_HOSTS=

# Optional: comma-separated list of additional img-src hosts (object-storage or
# image CDN origins).
# Example: https://images.your-cdn.com,https://storage.googleapis.com
CSP_EXTRA_IMG_HOSTS=

# DEV ONLY: Set to true to add unsafe-eval to script-src for Vite HMR.
# NEVER enable in production - this weakens XSS protection.
ENABLE_CSP_DEV_MODE=false

# Optional: Enable HTTP Strict-Transport-Security (HSTS) header.
# Only activate once HTTPS is confirmed stable for your deployment.
ENABLE_HSTS=false

